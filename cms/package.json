{
	"name": "pet-signals-cms",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Sanity Studio (content backend) for the Pet Signals blog. Not part of the Astro frontend build.",
	"scripts": {
		"dev": "sanity dev",
		"build": "sanity build",
		"deploy": "sanity deploy",
		"typecheck": "tsc --noEmit",
		"sanity": "sanity",
		"import:content": "tsx scripts/import-content.ts",
		"import:push": "tsx scripts/import-content.ts --push",
		"verify:content": "tsx scripts/verify-content.ts",
		"backup": "sanity dataset export production ./backups/production.tar.gz",
		"restore": "sanity dataset import ./backups/production.tar.gz production"
	},
	"dependencies": {
		"@sanity/vision": "^6.18.0",
		"react": "^19.2.2",
		"react-dom": "^19.2.2",
		"sanity": "^6.18.0",
		"styled-components": "^6.1.15"
	},
	"devDependencies": {
		"@sanity/client": "^8.9.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.0",
		"yaml": "^2.9.1"
	}
}
