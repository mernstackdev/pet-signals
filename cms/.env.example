# Copy to `.env` and fill in your Sanity project values.
# These are read by the Studio; the SANITY_STUDIO_ prefix makes them available
# to the browser bundle that runs the editor.

SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# Public site origin (used later by the frontend integration, and for preview links)
SANITY_STUDIO_SITE_URL=http://localhost:4321
