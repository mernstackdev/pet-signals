# Copy to `.env` and fill in your Sanity project values.
# The SANITY_STUDIO_ prefix makes them available to the Studio's browser bundle.

SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# Only needed for `npm run import:push` (writing content from this machine).
# Create one at sanity.io/manage → your project → API → Tokens (Editor role).
# Keep it out of git — `.env` is gitignored.
SANITY_API_WRITE_TOKEN=

# Public site origin (used by the frontend integration and for preview links)
SANITY_STUDIO_SITE_URL=http://localhost:4321
