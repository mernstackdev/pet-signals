---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import PortableText from '../../components/blog/PortableText.astro';
import { getAuthor, getPosts, getRelatedPosts } from '../../lib/content';
import { portableTextHeadings } from '../../lib/portable-text';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { cluster: post.data.cluster, slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const headings = portableTextHeadings(post.blocks);
const author = await getAuthor(post);
const related = await getRelatedPosts(post, 3);
---

<ArticleLayout post={post} author={author} headings={headings} related={related}>
	<PortableText blocks={post.blocks} />
</ArticleLayout>
