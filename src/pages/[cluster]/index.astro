---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import Container from '../../components/ui/Container.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { CLUSTERS } from '../../lib/clusters';
import { getPostsByCluster } from '../../lib/content';
import { clusterGraph } from '../../lib/schema';
import { canonicalUrl } from '../../lib/seo';

export async function getStaticPaths() {
	return CLUSTERS.map((cluster) => ({
		params: { cluster: cluster.slug },
		props: { cluster },
	}));
}

const { cluster } = Astro.props;
const posts = await getPostsByCluster(cluster.slug);
const url = canonicalUrl(`/${cluster.slug}/`);
const jsonLd = clusterGraph({
	url,
	clusterName: cluster.name,
	title: cluster.title,
	description: cluster.description,
	posts,
});
const otherClusters = CLUSTERS.filter((item) => item.slug !== cluster.slug);
---

<BaseLayout
	title={cluster.seoTitle}
	description={cluster.description}
	canonical={url}
	jsonLd={jsonLd}
>
	<Container class="pt-8">
		<Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: cluster.name }]} />
	</Container>

	<Container class="mt-6">
		<header class="max-w-3xl">
			<p class="text-sm font-semibold uppercase tracking-wide text-brand-700">Topic</p>
			<h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{cluster.title}</h1>
			<p class="mt-4 text-lg text-muted">{cluster.intro}</p>
		</header>
	</Container>

	<Container class="mt-12">
		<section aria-labelledby="cluster-articles">
			<h2 id="cluster-articles" class="sr-only">Articles in {cluster.name}</h2>
			{
				posts.length > 0 ? (
					<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{posts.map((post) => (
							<ArticleCard post={post} />
						))}
					</div>
				) : (
					<p class="text-muted">New {cluster.name.toLowerCase()} guides are on the way. Check back soon.</p>
				)
			}
		</section>
	</Container>

	<Container class="mt-16">
		<section aria-labelledby="more-topics">
			<h2 id="more-topics" class="text-2xl font-extrabold tracking-tight">Explore other topics</h2>
			<ul class="mt-6 grid gap-4 sm:grid-cols-2">
				{
					otherClusters.map((item) => (
						<li>
							<a
								href={`/${item.slug}/`}
								class="block h-full rounded-card bg-white p-6 ring-1 ring-stone-200 transition hover:ring-brand-400"
							>
								<span class="font-bold text-ink">{item.name}</span>
								<span class="mt-1 block line-clamp-2 text-sm text-muted">{item.description}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</Container>

	<div class="mt-16">
		<CtaBanner
			eyebrow="Every topic"
			title="Browse the full Pet Signals library"
			body="Behavior, habits, and how-to guides in one place."
			href="/articles/"
			label="See all articles"
		/>
	</div>
</BaseLayout>
