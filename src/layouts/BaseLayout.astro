---
import '../styles/global.css';

import Seo from '../components/global/Seo.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { SITE } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	type?: 'website' | 'article';
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	authorUrl?: string;
	section?: string;
	tags?: string[];
	jsonLd?: Record<string, unknown>;
}

const seo = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Seo {...seo} />
		<slot name="head" />
	</head>
	<body class="flex min-h-dvh flex-col">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:shadow-lg"
		>
			Skip to content
		</a>
		<Header />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
