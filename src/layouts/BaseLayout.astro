---
import '../styles/global.css';

import Seo from '../components/global/Seo.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { SITE } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	type?: 'website' | 'article';
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	authorUrl?: string;
	section?: string;
	tags?: string[];
	jsonLd?: Record<string, unknown>;
	markdownUrl?: string;
	/** Enables the distraction-free reading mode toggle on this page. */
	readable?: boolean;
}

const { readable, ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale} data-read-page={readable ? 'true' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Seo {...seo} />
		<script is:inline>
			// Apply saved reading preferences before first paint (article pages only).
			(function () {
				try {
					var root = document.documentElement;
					if (root.getAttribute('data-read-page') !== 'true') return;
					if (localStorage.getItem('ps-read-mode') === 'true') root.setAttribute('data-read-mode', 'true');
					var size = localStorage.getItem('ps-read-size');
					if (size) root.setAttribute('data-read-size', size);
					var theme = localStorage.getItem('ps-read-theme');
					if (theme) root.setAttribute('data-read-theme', theme);
				} catch (error) {}
			})();
		</script>
		<slot name="head" />
	</head>
	<body class="flex min-h-dvh flex-col">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:shadow-lg"
		>
			Skip to content
		</a>
		<Header />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
