---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div
	class:list={[
		'prose prose-lg prose-stone prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-tight prose-h2:mt-10 prose-h2:mb-3 prose-h2:text-2xl prose-h3:mt-7 prose-h3:text-xl sm:prose-h2:mt-12 sm:prose-h2:text-3xl sm:prose-h3:mt-8 sm:prose-h3:text-2xl prose-a:font-medium prose-a:text-brand-700 prose-a:underline prose-a:decoration-brand-300 prose-a:underline-offset-2 hover:prose-a:decoration-brand-500 prose-strong:text-ink prose-li:marker:text-brand-400 prose-blockquote:border-brand-300 prose-blockquote:font-normal prose-blockquote:text-muted prose-img:rounded-card prose-hr:border-stone-200',
		className,
	]}
>
	<slot />
</div>
