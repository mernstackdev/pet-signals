---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div
	class:list={[
		'prose prose-stone max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-tight prose-h2:mt-12 prose-h3:mt-8 prose-a:font-medium prose-a:text-brand-700 prose-a:no-underline hover:prose-a:underline prose-strong:text-ink prose-img:rounded-card prose-li:marker:text-brand-400 prose-hr:border-stone-200',
		className,
	]}
>
	<slot />
</div>
