---
interface Props {
	howTo: {
		name?: string;
		steps: Array<{ name: string; text: string }>;
	};
	class?: string;
}

const { howTo, class: className } = Astro.props;
---

<section
	class:list={['mt-10 rounded-card bg-white p-6 ring-1 ring-stone-200', className]}
	aria-labelledby="steps-heading"
>
	<h2 id="steps-heading" class="text-xl font-extrabold tracking-tight sm:text-2xl">
		{howTo.name ?? 'Step-by-step'}
	</h2>
	<ol class="mt-6 space-y-5">
		{
			howTo.steps.map((step, index) => (
				<li class="flex gap-4">
					<span
						class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700"
						aria-hidden="true"
					>
						{index + 1}
					</span>
					<div>
						<h3 class="font-bold text-ink">{step.name}</h3>
						<p class="mt-1 text-muted">{step.text}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>
