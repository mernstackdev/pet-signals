---
import type { Author } from '../../lib/content';

interface Props {
	author: Author;
	heading?: 'h2' | 'h3';
	class?: string;
}

const { author, heading: Heading = 'h2', class: className } = Astro.props;
---

<aside id={author.id} class:list={['scroll-mt-24 rounded-card bg-white p-6 ring-1 ring-stone-200', className]}>
	<Heading class="text-sm font-semibold uppercase tracking-wide text-muted">About the author</Heading>
	<p class="mt-3 font-bold text-ink">{author.data.name}</p>
	<p class="text-sm font-medium text-brand-700">{author.data.jobTitle}</p>
	<p class="mt-2 text-sm text-muted">{author.data.bio}</p>
	{
		author.data.knowsAbout.length > 0 && (
			<ul class="mt-4 flex flex-wrap gap-2">
				{author.data.knowsAbout.map((topic) => (
					<li class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">{topic}</li>
				))}
			</ul>
		)
	}
</aside>
