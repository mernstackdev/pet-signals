---
import type { Post } from '../../lib/content';
import ArticleCard from './ArticleCard.astro';

interface Props {
	posts: Post[];
	class?: string;
}

const { posts, class: className } = Astro.props;
---

{
	posts.length > 0 && (
		<section class:list={['mt-16', className]} aria-labelledby="related-heading">
			<h2 id="related-heading" class="text-xl font-extrabold tracking-tight sm:text-2xl">Related guides</h2>
			<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => (
					<ArticleCard post={post} />
				))}
			</div>
		</section>
	)
}
