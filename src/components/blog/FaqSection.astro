---
interface Props {
	faq: Array<{ question: string; answer: string }>;
	class?: string;
}

const { faq, class: className } = Astro.props;
---

{
	faq.length > 0 && (
		<section class:list={['mt-12', className]} aria-labelledby="faq-heading">
			<h2 id="faq-heading" class="text-xl font-extrabold tracking-tight sm:text-2xl">
				Frequently asked questions
			</h2>
			<dl class="mt-6 divide-y divide-stone-200">
				{faq.map((item) => (
					<div class="py-5 first:pt-0">
						<dt class="text-lg font-bold text-ink">{item.question}</dt>
						<dd class="mt-2 text-muted">{item.answer}</dd>
					</div>
				))}
			</dl>
		</section>
	)
}
