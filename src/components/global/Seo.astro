---
import { SITE } from '../../lib/site';
import { absoluteUrl, canonicalUrl } from '../../lib/seo';

export interface Props {
	/** Page title without the brand suffix. Omit on the homepage to use the site title. */
	title?: string;
	description?: string;
	canonical?: string;
	type?: 'website' | 'article';
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	authorUrl?: string;
	section?: string;
	tags?: string[];
	jsonLd?: Record<string, unknown>;
	prevUrl?: string;
	nextUrl?: string;
}

const {
	title,
	description = SITE.description,
	canonical = canonicalUrl(Astro.url.pathname),
	type = 'website',
	image = absoluteUrl(SITE.defaultOgImage),
	imageAlt = SITE.tagline,
	noindex = false,
	publishedTime,
	modifiedTime,
	authorUrl,
	section,
	tags = [],
	jsonLd,
	prevUrl,
	nextUrl,
} = Astro.props;

const brandedTitle = title ? `${title} | ${SITE.name}` : SITE.title;
// Keep titles within the ~60-character SERP window; drop the brand suffix when it would overflow.
const fullTitle = !title ? SITE.title : brandedTitle.length <= 60 ? brandedTitle : title;
const robots = noindex
	? 'noindex,nofollow'
	: 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1';
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(SITE.ogImageWidth)} />
<meta property="og:image:height" content={String(SITE.ogImageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:locale:alternate" content={SITE.ogLocaleAlternate} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

{
	type === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime} />
	)
}
{
	type === 'article' && modifiedTime && (
		<meta property="article:modified_time" content={modifiedTime} />
	)
}
{type === 'article' && authorUrl && <meta property="article:author" content={authorUrl} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

{prevUrl && <link rel="prev" href={prevUrl} />}
{nextUrl && <link rel="next" href={nextUrl} />}
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE.name} RSS feed`}
	href={absoluteUrl('/rss.xml')}
/>
<link rel="sitemap" type="application/xml" href={absoluteUrl('/sitemap-index.xml')} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

{json && <script type="application/ld+json" set:html={json} />}
