---
interface Item {
	name: string;
	url?: string;
}

interface Props {
	items: Item[];
	class?: string;
}

const { items, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={['text-sm', className]}>
	<ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
		{
			items.map((item, index) => (
				<li class="flex items-center gap-2">
					{index > 0 && (
						<span aria-hidden="true" class="text-stone-400">
							/
						</span>
					)}
					{item.url ? (
						<a href={item.url} class="hover:text-brand-700">
							{item.name}
						</a>
					) : (
						<span aria-current="page" class="font-medium text-ink">
							{item.name}
						</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
