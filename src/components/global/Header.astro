---
import { NAV_LINKS } from '../../lib/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
---

<header data-chrome class="sticky top-0 z-40 border-b border-stone-200 bg-cream/85 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6 lg:px-8">
		<a href="/" class="shrink-0 rounded-md" aria-label="Pet Signals — home">
			<Logo />
		</a>

		<nav aria-label="Primary" class="hidden sm:block">
			<ul class="flex items-center gap-1 text-sm font-medium">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								class="block whitespace-nowrap rounded-full px-3 py-2.5 text-muted transition-colors hover:bg-brand-50 hover:text-brand-700"
								aria-current={path === link.href ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<details class="group sm:hidden">
			<summary
				class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full text-ink ring-1 ring-stone-300 transition hover:bg-stone-50 [&::-webkit-details-marker]:hidden"
			>
				<span class="sr-only">Menu</span>
				<svg
					viewBox="0 0 20 20"
					class="h-5 w-5 group-open:hidden"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					aria-hidden="true"
				>
					<path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round"></path>
				</svg>
				<svg
					viewBox="0 0 20 20"
					class="hidden h-5 w-5 group-open:block"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					aria-hidden="true"
				>
					<path d="M5 5l10 10M15 5 5 15" stroke-linecap="round"></path>
				</svg>
			</summary>
			<nav
				aria-label="Mobile"
				class="absolute inset-x-0 top-full z-50 border-b border-stone-200 bg-cream shadow-lg"
			>
				<ul class="mx-auto max-w-6xl space-y-1 px-4 py-3 sm:px-6">
					{
						NAV_LINKS.map((link) => (
							<li>
								<a
									href={link.href}
									class="block rounded-xl px-4 py-3 text-base font-medium text-ink transition hover:bg-brand-50 hover:text-brand-800"
									aria-current={path === link.href ? 'page' : undefined}
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</details>
	</div>
</header>
