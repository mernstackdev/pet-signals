---
import { NAV_LINKS } from '../../lib/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
---

<header
	data-chrome
	class="sticky top-0 z-40 border-b border-stone-200 bg-cream/85 backdrop-blur"
>
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6 lg:px-8">
		<a href="/" class="shrink-0 rounded-md" aria-label="Pet Signals — home">
			<Logo />
		</a>
		<nav aria-label="Primary" class="min-w-0 flex-1">
			<ul
				class="flex items-center justify-start gap-1 overflow-x-auto text-sm font-medium [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:justify-end"
			>
				{
					NAV_LINKS.map((link) => (
						<li class="shrink-0">
							<a
								href={link.href}
								class="block whitespace-nowrap rounded-full px-3 py-2.5 text-muted transition-colors hover:bg-brand-50 hover:text-brand-700"
								aria-current={path === link.href ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
