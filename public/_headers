# Cloudflare Pages / Workers response headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# NOTE: no Content-Security-Policy here on purpose — the site uses small inline
# scripts (read mode, copy-page, pre-paint theme), which a strict CSP would block.

# Fingerprinted build assets never change, so cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Serve the per-article Markdown alternates as Markdown rather than a download.
/*.md
  Content-Type: text/markdown; charset=utf-8

# AI discovery files should be plain text.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8

# Site-wide headers.
# No-Vary-Search stops tracking parameters from creating duplicate cache entries.
/*
  No-Vary-Search: key-order, params=("utm_source" "utm_medium" "utm_campaign" "utm_content" "utm_term" "gclid" "fbclid" "msclkid")
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
