# ---- Site origin -------------------------------------------------------------
# Used for canonical URLs, JSON-LD @id, the sitemap, RSS and llms.txt.
#
# Leave unset and the build detects the host automatically:
#   - Vercel:      VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL
#   - Netlify:     URL / DEPLOY_PRIME_URL
#   - Cloudflare:  CF_PAGES_URL
#   - otherwise:   http://localhost:4321 (local development)
#
# Set this in production to pin the real domain:
# SITE_URL=https://your-domain.com
SITE_URL=

# ---- Sanity (content) --------------------------------------------------------
# The site is statically generated, so content is fetched at build time.
# PUBLIC_* is exposed to the build (safe); the read token is server-side only.
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Required while the dataset is private (ours is). Prefer a read-only token:
# sanity.io/manage → project → API → Tokens → Viewer.
# Set it as a build variable in Cloudflare too, or the build cannot read content.
SANITY_API_READ_TOKEN=
